# 钉钉应用凭证（必填，在钉钉开发者后台获取）
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# 目标审批配置（必填）
TARGET_PROCESS_CODE=
TARGET_SYSTEM_SOURCE=AI工具账号

# 审批执行人 userId（必填）：必须是审批任务当前处理人
ACTIONER_USER_ID=

# 通知配置（推荐）
# AgentId: 钉钉应用的 AgentId
DINGTALK_AGENT_ID=
# 通知接收人: 接收审批结果通知的用户 userId
NOTIFY_USER_ID=

# 告警通道：dingtalk / qclaw / webhook / none，可用逗号配置 fallback，例如 dingtalk,qclaw
ALERT_CHANNEL=dingtalk
QCLAW_WEBHOOK_URL=
ALERT_WEBHOOK_URL=

# 服务与兜底监控
SERVICE_NAME=dingtalk-bot.service
LAUNCHD_LABEL=com.gomoai.dingtalk-auto-approve
ALERT_THRESHOLD_MIN=5
BACKUP_AUTO_APPROVE=true

# bot 心跳；monitor.sh 会在心跳过期时重启服务并告警
HEARTBEAT_INTERVAL=60
HEARTBEAT_MAX_AGE=180
WATCHDOG_ALERT_INTERVAL=300
